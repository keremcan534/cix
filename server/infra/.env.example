# /opt/similar/.env: sunucunun bütün ayarları ve sırları. Git'e girmez; yalnızca sunucuda durur (chmod 600).
# setup.sh bu dosyadan kopyalar ve DOMAIN, POSTGRES_PASSWORD, LIVEKIT_KEYS değerlerini kendisi üretir.
# Boş bırakılan özellikler kapalı kalır ve API "henüz açık değil" (503) cevabı verir.

# --- Temel ---------------------------------------------------------------------------------------------
# HTTPS adresi (Caddy sertifikayı kendisi alır). Alan adı gelene kadar: 130-61-230-94.sslip.io
DOMAIN=
POSTGRES_USER=similar
POSTGRES_PASSWORD=
POSTGRES_DB=similar
# LiveKit anahtar çifti, "anahtar: sır" biçiminde. API ve LiveKit aynı çifti kullanır.
LIVEKIT_KEYS=
# Web'den API'yi çağırabilecek ek adresler, virgülle (ör. https://similarclub.com).
ALLOWED_ORIGINS=

# --- Yayın anahtarları ---------------------------------------------------------------------------------
# Geliştirme girişi (cihaz anahtarı). Telefonla giriş açılınca 0 yap.
ALLOW_DEV_AUTH=1
# Test jeton yüklemesi ve serbest miktarlı test hediyesi. Mağaza ödemesi açılınca 0 yap.
ALLOW_TEST_TOPUP=1

# --- Telefonla giriş (SMS) -----------------------------------------------------------------------------
# netgsm, twilio veya log (kodu yalnızca API kaydına yazar; sadece test sunucusu için).
SMS_PROVIDER=
NETGSM_USER=
NETGSM_PASS=
# Netgsm'de onaylı gönderici adı (başlık).
NETGSM_HEADER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Kod istenebilecek ülke kodları, virgülle.
OTP_COUNTRIES=+90
# App Store / Google Play incelemecisi için SMS'siz giriş: bu numara + bu kod. İnceleme notuna yazılır.
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=

# --- Bildirimler (Expo push) ---------------------------------------------------------------------------
# Expo projesinde "push security" açıksa erişim anahtarı.
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=1

# --- Mağaza ödemeleri ----------------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE=com.similarclub.app
# Play Console'a bağlı Google Cloud hizmet hesabının JSON anahtarı, tek satır.
GOOGLE_SERVICE_ACCOUNT=
APPLE_BUNDLE_ID=com.similarclub.app
# App Store Connect → Users and Access → Integrations → In-App Purchase anahtarı.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# .p8 dosyasının içeriği, satır sonları \n olarak.
APPLE_IAP_PRIVATE_KEY=

# --- Fotoğraf / video depolama (S3 uyumlu: Cloudflare R2 önerilir) ---------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_KEY=
S3_SECRET=
# Kovanın herkese açık https adresi veya CDN alan adı.
S3_PUBLIC_URL=

# --- Yedek ---------------------------------------------------------------------------------------------
# rclone hedefi (ör. r2:similar-yedek). Boşsa yedek yalnızca sunucuda kalır.
BACKUP_RCLONE_REMOTE=
# Başarılı yedekte çağrılan adres (healthchecks.io gibi); hata olursa sonuna /fail eklenerek çağrılır.
BACKUP_PING_URL=

# --- İnce ayar (genelde dokunulmaz) ----------------------------------------------------------------------
# Dakikalık sınırlar: IP başına giriş, oturum başına istek, IP başına toplam.
RATE_AUTH=20
RATE_ALL=120
RATE_IP=600
# Her isteğe bir kayıt satırı (yöntem, yol, durum, süre). Kapatmak için 0.
LOG_REQUESTS=1
PG_POOL=10
