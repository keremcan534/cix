# /opt/similar/.env: sunucunun bütün ayarları ve sırları. Git'e girmez; yalnızca sunucuda durur (chmod 600).
# setup.sh bu dosyadan kopyalar ve DOMAIN, POSTGRES_PASSWORD, LIVEKIT_KEYS değerlerini kendisi üretir.
# Boş bırakılan özellikler kapalı kalır ve API "henüz açık değil" (503) cevabı verir.

# --- Temel ---------------------------------------------------------------------------------------------
# HTTPS adresi (Caddy sertifikayı kendisi alır). Alan adı gelene kadar: 130-61-230-94.sslip.io
DOMAIN=
POSTGRES_USER=similar
POSTGRES_PASSWORD=
POSTGRES_DB=similar
# LiveKit anahtar çifti, "anahtar: sır" biçiminde. API ve LiveKit aynı çifti kullanır.
LIVEKIT_KEYS=
# Web'den API'yi çağırabilecek ek adresler, virgülle (ör. https://similarclub.com).
ALLOWED_ORIGINS=

# --- Yayın anahtarları ---------------------------------------------------------------------------------
# Geliştirme girişi (cihaz anahtarı). Yalnızca 1 iken açık; satır yoksa kapalı. Telefonla giriş açılınca 0 yap.
ALLOW_DEV_AUTH=1
# Test jeton yüklemesi, test satın alması ve serbest miktarlı test hediyesi. Mağaza ödemesi açılınca 0 yap.
# Açıkken bu sunucuda para çekme talebi ödenemez (yalnızca reddedilir).
ALLOW_TEST_TOPUP=1
# Bir hesaba günde en çok kaç test jetonu (test yüklemesi + test satın alması + ilk alım hediyesi).
TEST_TOPUP_DAILY=50000
# Mağaza test satın alması (Google Play lisans testçisi / promosyon kodu, App Store sandbox ve TestFlight)
# jeton yüklesin mi. 0 iken reddedilir ve tüketilmez. 1 iken test jetonu sayılır ve para çekme ödenemez.
ALLOW_SANDBOX_PURCHASES=0
# Uygulamadaki örnek odalara (oda-r1 …) ses izni. Yalnızca geliştirme sunucusunda 1.
ALLOW_PROTOTYPE_ROOMS=0

# --- Jeton kaynağı ve elmas kilidi (wallet.mjs) ---------------------------------------------------------
# Hediye edilen mağaza jetonunun (Google Play / App Store) elması kaç gün kilitli kalır (iade süresi).
LOCK_DAYS_STORE=7
# Jeton Noktası'ndan alınan jetonun elması kaç gün kilitli kalır.
LOCK_DAYS_JETON=1
# Harcama sırası: boş = önce mağaza jetonu; fifo = en eski parti önce.
COIN_SPEND_ORDER=

# --- Telefonla giriş (SMS) -----------------------------------------------------------------------------
# netgsm, twilio veya log (kodu yalnızca API kaydına yazar; sadece test sunucusu için).
SMS_PROVIDER=
NETGSM_USER=
NETGSM_PASS=
# Netgsm'de onaylı gönderici adı (başlık).
NETGSM_HEADER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Kod istenebilecek ülke kodları, virgülle.
OTP_COUNTRIES=+90
# App Store / Google Play incelemecisi için SMS'siz giriş: bu numara + bu kod. İnceleme notuna yazılır.
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=
# İnceleme numarası bir saatte bu kadar yanlış kod alınca bir saat kilitlenir.
OTP_REVIEW_MAX_TRIES=10
# Bütün numaralara bir saatte en çok kaç SMS kodu gider (SMS faturasına karşı).
OTP_GLOBAL_PER_HOUR=300

# --- Google ile giriş (docs/SUNUCU.md "Google ile giriş") ------------------------------------------------
# Google Cloud'daki OAuth istemci kimlikleri, virgülle: önce Web istemcisi (uygulama da bunu kullanır),
# istenirse Android istemcisi. Boşsa "Google ile devam et" kapalı kalır (503).
GOOGLE_CLIENT_IDS=

# --- Bildirimler (Expo push)---------------------------------------------------------------------------
# Expo projesinde "push security" açıksa erişim anahtarı.
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=1

# --- Mağaza ödemeleri ----------------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE=com.similarclub.app
# Play Console'a bağlı Google Cloud hizmet hesabının JSON anahtarı, tek satır.
GOOGLE_SERVICE_ACCOUNT=
# Google Play iadeleri (voided purchases) kaç dakikada bir okunur; 0 = kapalı.
GOOGLE_VOIDED_POLL_MIN=60
APPLE_BUNDLE_ID=com.similarclub.app
# App Store Connect → Users and Access → Integrations → In-App Purchase anahtarı.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# .p8 dosyasının içeriği, satır sonları \n olarak.
APPLE_IAP_PRIVATE_KEY=

# --- Fotoğraf / video depolama (S3 uyumlu: Cloudflare R2 önerilir) ---------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_KEY=
S3_SECRET=
# Kovanın herkese açık https adresi veya CDN alan adı.
S3_PUBLIC_URL=

# --- Finans paneli (Finance Control, docs/SUNUCU.md "Finans paneli") ------------------------------------
# Panelde Entegrasyonlar → similarclub → "Anahtar üret" ile alınan anahtar. Boşsa API panele bir şey göndermez.
FINANCE_API_KEY=
# Panelin ilk yönetici hesabı (yalnızca ilk açılışta kullanılır). Boşsa panel kendisi üretir ve
# /data/giris-bilgileri.txt dosyasına yazar.
FC_ADMIN_EMAIL=
FC_ADMIN_PASSWORD=

# --- Yedek ---------------------------------------------------------------------------------------------
# rclone hedefi (ör. r2:similar-yedek). Boşsa yedek yalnızca sunucuda kalır.
BACKUP_RCLONE_REMOTE=
# Başarılı yedekte çağrılan adres (healthchecks.io gibi); hata olursa sonuna /fail eklenerek çağrılır.
BACKUP_PING_URL=

# --- Hata izleme (Sentry, docs/SUNUCU.md "Hata izleme ve acil durum") -------------------------------------
# Sentry projesinin DSN adresi (Settings → Client Keys). Boşsa sunucu hataları yalnızca kayıtta kalır.
SENTRY_DSN=
# Sentry'de hangi ortam olarak görünsün (production, test…).
SENTRY_ENVIRONMENT=production

# --- Uygulamayı uzaktan yönetme (değişince: sudo docker compose up -d api) ---------------------------------
# Bu sürümün altındaki uygulamalar "Güncelleme gerekli" ekranında kalır (ör. 1.0.3). Boşsa kimse engellenmez.
APP_MIN_VERSION=
# O ekrandaki "Güncelle" düğmesinin açtığı adres: mağaza sayfası veya APK indirme bağlantısı (https).
APP_UPDATE_URL=
# Uygulamanın üstünde gösterilecek kısa duyuru (ör. bakım saati). Boşsa duyuru yok.
APP_NOTICE=
# Geçici olarak kapatılacak özellikler, virgülle: gifts (hediye), purchases (mağaza satın alma), topup (test
# yükleme), exchange (elmas çevirme), jeton (Jeton Noktası), games (oyunlar), dm (özel mesaj), rooms (sesli oda),
# withdraw (yeni para çekme talebi).
# Sunucu da reddeder; bakiyeler ve geçmiş görünmeye devam eder. Boşsa hepsi açık.
FEATURES_OFF=

# --- İletişim filtresinin otomatik susturması (docs/YAPTIRIM.md "Otomatik susturma") -----------------------
# Telefon, IBAN, e-posta, bağlantı veya sosyal medya adı yazma denemesi (ret) bu sayıya ulaşınca kişi otomatik
# susturulur: özel mesaj ve oda sohbeti yazamaz (ses serbest). 0 = kapalı. Yönetici ve moderatöre uygulanmaz.
AUTO_MUTE_REFUSALS=5
# Retler kaç dakika içinde sayılır (DM ve oda sohbetini kapatan son susturma bittikten ya da kaldırıldıktan
# sonrakiler; susturma sürerken yapılan retler sayılmaz).
AUTO_MUTE_WINDOW=60
# Susturma kaç dakika sürer.
AUTO_MUTE_MINUTES=60

# --- Alarm eşikleri (/api/health uyarıları; aşılınca GitHub e-posta atar) ---------------------------------
# Diskte boş yer yüzde kaçın altına inince.
ALERT_DISK_FREE_PCT=15
# Son 15 dakikada kaç sunucu hatasından (5xx) fazlası olunca.
ALERT_5XX_15M=20
# Finans paneline aktarım kaç dakikadır başarılı olmayınca (FINANCE_API_KEY doluysa).
ALERT_FINANCE_STALE_MIN=15
# Son 1 saatte kaç mağaza iadesinden fazlası olunca.
ALERT_REFUNDS_1H=3
# Tek bir hesap son 1 saatte kaç elmastan fazla alınca (5.000 elmas = 1 USD).
ALERT_DIAMONDS_1H=500000
# Son 1 saatte toplam kaç test jetonundan fazlası yüklenince.
ALERT_TEST_TOPUP_1H=500000

# --- İnce ayar (genelde dokunulmaz) ----------------------------------------------------------------------
# Dakikalık sınırlar: IP başına giriş, oturum başına istek, IP başına toplam.
RATE_AUTH=20
RATE_ALL=120
RATE_IP=600
# Her isteğe bir kayıt satırı (yöntem, yol, durum, süre). Kapatmak için 0.
LOG_REQUESTS=1
PG_POOL=10
# Ses odası bileti kaç saniye geçerli (60–86400). LiveKit bağlı kişinin biletini kendisi yeniler.
LIVEKIT_TOKEN_TTL_S=600
