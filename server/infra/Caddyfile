# /opt/similar/Caddyfile: HTTPS with an automatic Let's Encrypt certificate for DOMAIN (.env).
#   /api/* and /token → the API (127.0.0.1:7890)
#   everything else   → LiveKit (127.0.0.1:7880, WebSocket signalling at /rtc; "/" answers OK)
# panel.DOMAIN: the finance panel (127.0.0.1:4300).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# LiveKit calls the webhook on 127.0.0.1 directly; from outside it doesn't exist. (handle blocks are
	# exclusive and tried in this order, so this one must stay first.)
	@internal path /api/livekit/webhook
	handle @internal {
		respond 404
	}

	@api path /api/* /token
	handle @api {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:7890
	}

	handle {
		reverse_proxy 127.0.0.1:7880
	}
}

# The finance panel (Finance Control, compose service "finance"). Only reachable through here; its own
# login (with 2FA) guards it. sslip.io answers for panel.<ip>.sslip.io too, so no DNS record is needed.
panel.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	request_body {
		max_size 20MB
	}
	reverse_proxy 127.0.0.1:4300
}
