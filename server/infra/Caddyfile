# /opt/similar/Caddyfile: HTTPS with an automatic Let's Encrypt certificate for DOMAIN (.env).
#   /api/* and /token → the API (127.0.0.1:7890)
#   everything else   → LiveKit (127.0.0.1:7880, WebSocket signalling at /rtc; "/" answers OK)
# panel.DOMAIN: the finance panel (127.0.0.1:4300).
{$DOMAIN:130-61-230-94.sslip.io} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# LiveKit calls the webhook on 127.0.0.1 directly; from outside it doesn't exist. (handle blocks are
	# exclusive and tried in this order, so this one must stay first.)
	@internal path /api/livekit/webhook
	handle @internal {
		respond 404
	}

	@api path /api/* /token
	handle @api {
		request_body {
			max_size 1MB
		}
		# The finance panel's key opens admin routes only from this machine (server/api/panel.mjs): never from outside.
		request_header -X-Panel-Key
		request_header -X-Panel-User
		reverse_proxy 127.0.0.1:7890
	}

	handle {
		reverse_proxy 127.0.0.1:7880
	}
}

# The finance panel (Finance Control, compose service "finance"). Only reachable through here; its own
# login (with 2FA) guards it. sslip.io answers for panel.<ip>.sslip.io too, so no DNS record is needed.
panel.{$DOMAIN:130-61-230-94.sslip.io} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Uygulama › Hediyeler: an icon, a video or an SVGA goes through the panel to the storage, streamed (a video
	# source up to 500 MB, media.mjs giftsource).
	@upload path /api/app/upload
	request_body @upload {
		max_size 510MB
	}
	@other not path /api/app/upload
	request_body @other {
		max_size 20MB
	}
	reverse_proxy 127.0.0.1:4300
}
