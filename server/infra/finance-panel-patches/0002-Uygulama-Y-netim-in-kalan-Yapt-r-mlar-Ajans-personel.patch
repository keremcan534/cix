+        { key: 'at', label: 'Ne zaman', render: (p) => dateTimeTr(p.createdAt) },
+        {
+          key: 'a',
+          label: '',
+          render: (p) =>
+            p.status === 'open' &&
+            html`<span class="row gap">
+              <${Button} onClick=${() => decide(p, true)}>Kabul</${Button}>
+              <${Button} kind="ghost" onClick=${() => decide(p, false)}>Ret</${Button}>
