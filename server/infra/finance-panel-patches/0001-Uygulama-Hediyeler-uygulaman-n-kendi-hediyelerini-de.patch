+  const [stickerEdit, setStickerEdit] = useState(null);
+
+  if (!meta.app_link)
+    return html`<${Page} title="Uygulama emojileri"><div class="empty bad">Uygulama bağlantısı ayarlı değil: sunucuda FC_APP_API_URL ve FC_APP_API_KEY gerekli.</div></${Page}>`;
