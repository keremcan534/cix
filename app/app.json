{
  "expo": {
    "name": "Similar Club",
    "slug": "similar-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.similarclub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.similarclub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Gerçek kişi doğrulaması için selfie çekmen gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#080F1E",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#080F1E"
          }
        }
      ]
    ],
    "scheme": "similarclub",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#080F1E"
  }
}
