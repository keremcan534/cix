{
  "expo": {
    "name": "Similar Club",
    "slug": "similar-club",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.similarclub.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#010E29",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.similarclub.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Gerçek kişi doğrulaması için selfie çekmen gerekiyor.",
          "microphonePermission": "Sesli odalarda konuşabilmen ve sesli/görüntülü arama yapabilmen için mikrofonuna erişmemiz gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-native.png",
          "backgroundColor": "#010E29",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon-native.png",
            "backgroundColor": "#010E29"
          }
        }
      ],
      "expo-font",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Görüntülü arama ve eşleşmede kendini gösterebilmen için kameranı kullanmamız gerekiyor.",
          "microphonePermission": "Sesli odalarda, aramalarda ve eşleşmede konuşabilmen için mikrofonuna erişmemiz gerekiyor."
        }
      ],
      [
        "@sentry/react-native",
        {
          "disableAutoUpload": true
        }
      ],
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      "./plugins/with-android-release-build",
      "./plugins/with-app-self-update",
      "./plugins/with-animated-webp",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#13D9DF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Sesli odalarda, aramalarda ve eşleşmede konuşabilmen için mikrofonuna erişmemiz gerekiyor."
        }
      ]
    ],
    "scheme": "similarclub",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#010E29"
  }
}
