<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The room keeps playing and the mic keeps sending while the app is in the background (Android 14 needs the type
       permissions too). The notification shows that the room is still open. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service
      android:name="expo.modules.similarroomservice.RoomAudioService"
      android:exported="false"
      android:foregroundServiceType="microphone|mediaPlayback" />
  </application>
</manifest>
